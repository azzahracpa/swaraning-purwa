# =====================================================================
# Swaraning Purwa - contoh konfigurasi environment
# Salin menjadi .env lalu jalankan: php artisan key:generate
# File .env TIDAK BOLEH di-commit. Di Vercel, isi variabel ini lewat
# Project Settings > Environment Variables (Preview dan Production beda).
# =====================================================================

APP_NAME="Swaraning Purwa"
# local untuk laptop, production untuk Vercel
APP_ENV=local
# Buat dengan: php artisan key:generate --show (produksi wajib diisi)
APP_KEY=
# Produksi wajib false supaya detail error tidak bocor
APP_DEBUG=true
# Produksi: isi URL https dari Vercel, misal https://swaraning-purwa.vercel.app
# Jika diawali https://, semua link otomatis dipaksa https.
APP_URL=http://localhost:8000

# Zona waktu museum (Malang, WIB). Dipakai untuk "hari ini", jadwal, dan tanggal reservasi.
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Vercel tidak punya disk permanen, jadi log dikirim ke stderr
# dan bisa dibaca di menu Logs pada dashboard Vercel.
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Basis data MySQL. Produksi memakai MySQL terkelola (host, port, user,
# password dari penyedia). Jangan pernah menulis kredensial asli di repo.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=swaraning_purwa
DB_USERNAME=root
DB_PASSWORD=
# Isi jika penyedia MySQL mewajibkan SSL, misal /etc/ssl/certs/ca-certificates.crt
MYSQL_ATTR_SSL_CA=

# Sesi dan cache disimpan di database (tabel sessions dan cache),
# karena file di server Vercel hilang setiap request baru.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Produksi (https) sebaiknya true
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

# Disk penyimpanan upload (foto koleksi, gambar artikel, gambar profil museum)
# Lokal: public (jalankan php artisan storage:link sekali)
# Produksi: s3 (penyimpanan S3 kompatibel, isi variabel AWS_* di bawah)
FILESYSTEM_DISK=public

# Kredensial penyimpanan S3 kompatibel (hanya untuk produksi)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
# Endpoint API S3 dari penyedia (kosongkan jika memakai AWS S3 asli)
AWS_ENDPOINT=
# URL publik bucket untuk menampilkan gambar
AWS_URL=
# true untuk kebanyakan penyedia S3 kompatibel
AWS_USE_PATH_STYLE_ENDPOINT=false

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@swaraning-purwa.test"
MAIL_FROM_NAME="${APP_NAME}"

# Password akun contoh dari seeder. Untuk produksi ganti dengan nilai kuat
# lewat variabel terminal saat menjalankan seeder, bukan di file ini.
SEED_ADMIN_PASSWORD=password
SEED_USER_PASSWORD=password

VITE_APP_NAME="${APP_NAME}"
